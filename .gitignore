# Supabase CLI local state, created by `npx supabase link`.
# .temp holds the linked project ref and pooler details; .branches and
# .env are local-only. None of it belongs in a public repo.
supabase/.temp/
supabase/.branches/
supabase/.env

# Never commit secrets. The service-role key bypasses every RLS policy, so a
# stray .env here would hand over the whole database.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Generated by tests/helpers/load-main.mjs: js/main.js with its imports
# rewritten to stubs. Regenerated on every run, never edited by hand.
tests/.harness/

# macOS
.DS_Store
.netrc
